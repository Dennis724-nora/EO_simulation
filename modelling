from vpython import *
from numpy import *

########################
# 基本參數設定
########################
N = 100                 # grid 點數（N x N）
d = 100e-6              # 整個 mask 的實體尺寸（這裡先隨便給一個 100 μm）
dx, dy = d/N, d/N       # 每一格的實體長度

# 圓形 aperture 半徑（你可以改這個來控制開孔大小）
aperture_radius = 0.2 * d   # 例如整塊的 20%

########################
# 場景設定
########################
scene1 = canvas(title="Aperture mask",
                align='left', height=600, width=600,
                center=vector(d/2, d/2, 0), background=color.white)

scene2 = canvas(title="Complementary mask",
                align='right', x=610, height=600, width=600,
                center=vector(d/2, d/2, 0), background=color.white)

########################
# 建立 mask matrix
########################
# aperture_mask[i,j] = 1 代表透明, 0 代表遮擋
aperture_mask = zeros((N, N))

# 計算中心位置（實體座標）
cx, cy = d/2, d/2

for i in range(N):
    for j in range(N):
        # 每一格的小中心點座標
        x = (i + 0.5) * dx
        y = (j + 0.5) * dy

        r = sqrt((x - cx)**2 + (y - cy)**2)

        if r <= aperture_radius:
            aperture_mask[i, j] = 1.0   # 在圓形內 → 開孔
        else:
            aperture_mask[i, j] = 0.0   # 圓外 → 遮擋

# complementary mask：1 - aperture
complementary_mask = 1.0 - aperture_mask

########################
# 將 mask 視覺化
########################
thickness = d / 100   # 掩膜的厚度（z 方向）

# 為了效率，我們只畫「有東西的格子」
for i in range(N):
    for j in range(N):
        x = (i + 0.5) * dx
        y = (j + 0.5) * dy

        # Scene1：aperture mask
        if aperture_mask[i, j] > 0.5:
            # 透明区域，畫成淺藍色格子
            box(canvas=scene1,
                pos=vector(x, y, 0),
                size=vector(dx, dy, thickness),
                color=vector(0.4, 0.7, 1.0),
                opacity=0.6)
        else:
            # 遮擋区域，畫成灰色格子
            box(canvas=scene1,
                pos=vector(x, y, 0),
                size=vector(dx, dy, thickness),
                color=vector(0.5, 0.5, 0.5),
                opacity=0.8)

        # Scene2：complementary mask
        if complementary_mask[i, j] > 0.5:
            # 透明区域
            box(canvas=scene2,
                pos=vector(x, y, 0),
                size=vector(dx, dy, thickness),
                color=vector(0.4, 0.7, 1.0),
                opacity=0.6)
        else:
            # 遮擋区域
            box(canvas=scene2,
                pos=vector(x, y, 0),
                size=vector(dx, dy, thickness),
                color=vector(0.5, 0.5, 0.5),
                opacity=0.8)

print("Simulation 1 完成：已建立 aperture_mask 與 complementary_mask。")
